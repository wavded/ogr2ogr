{
  "name": "ogr2ogr",
  "version": "7.0.1",
  "description": "ogr2ogr wrapper w/ multiple format support",
  "keywords": [
    "gdal",
    "ogr2ogr",
    "proj4",
    "stream"
  ],
  "homepage": "http://github.com/wavded/ogr2ogr",
  "author": "Marc Harter <wavded@gmail.com>",
  "repository": {
    "type": "git",
    "url": "http://github.com/wavded/ogr2ogr.git"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepack": "bun run build",
    "build": "bun build ./index.ts --target=node --format=esm --packages=external --outfile=dist/index.js && tsc --declaration --emitDeclarationOnly --outDir dist",
    "test": "bun test",
    "lint": "bun check && oxlint . && bun fmt --check",
    "fix": "oxlint --fix . && bun fmt"
  },
  "dependencies": {
    "archiver": "^8.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.5.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12 <23 || >=24 <25 || >=26 <27"
  },
  "packageManager": "bun@1.4.4"
}
