{
  "name": "ogr2ogr",
  "version": "6.0.1",
  "description": "ogr2ogr wrapper w/ multiple format support",
  "keywords": [
    "gdal",
    "ogr2ogr",
    "proj4",
    "stream"
  ],
  "homepage": "http://github.com/wavded/ogr2ogr",
  "author": "Marc Harter <wavded@gmail.com>",
  "repository": {
    "type": "git",
    "url": "http://github.com/wavded/ogr2ogr.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsdown",
    "test": "vitest run",
    "lint": "tsc --noEmit && oxlint . && oxfmt --check .",
    "fix": "oxlint --fix . && oxfmt ."
  },
  "dependencies": {
    "archiver": "^8.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.1.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "ts-node": "^10.9.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "tsdown": {
    "dts": true,
    "entry": "index.ts",
    "fixedExtension": false,
    "format": [
      "esm",
      "cjs"
    ]
  },
  "engines": {
    "node": ">=22.12 <23 || >=24 <25 || >=26 <27"
  }
}
